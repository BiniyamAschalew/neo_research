#!/usr/bin/env python3
"""Start the first mate for a project: local inbox watcher in the background, then the chosen agent
with the ar_mate rules in its standing instructions, so it stays the mate through long sessions.

    ar_mate                      # in the project folder; default agent: claude (or $AR_AGENT)
    ar_mate codex                # Codex as the mate
    ar_mate codex --ask          # keep the agent's normal approval prompts
    ar_mate claude --project ../my-project -- --model opus     # flags after -- go to the agent

Claude gets the rules via --append-system-prompt-file, Codex via developer_instructions.
Approvals: Claude starts in auto mode, Codex in "Approve for me"; --ask keeps normal prompts.
The mate cannot write code: Claude via a PreToolUse hook, Codex via a sandbox whose only writable
folder is __board__/; anything else goes to a reviewer with the mate policy (skills/ar_mate/mate_review_policy.md).
The status table is printed before the agent starts (no tokens); the agent's first turn is your first message.
Other installed agent CLIs start with the rules in their first prompt only.
"""

import argparse
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import subprocess
import sys

NEO = Path(__file__).resolve().parent
SKILL = NEO / "skills/ar_mate/SKILL.md"
WATCH = NEO / "skills/ar_mate/scripts/mate_watch.py"
STATUS = NEO / "skills/ar_mate/scripts/mate_status.py"
GUARD = {"claude": NEO / "skills/ar_mate/scripts/mate_guard.py", "codex": NEO / "skills/ar_mate/mate_review_policy.md"}
_notify = importlib.util.spec_from_file_location("slack_notify", NEO / "skills/ar_notify/scripts/slack_notify.py")
PROJECT_ENV = importlib.util.module_from_spec(_notify)
_notify.loader.exec_module(PROJECT_ENV)
_spec = importlib.util.spec_from_file_location("agents", NEO / "skills/references/agents.py")
AGENTS = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(AGENTS)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("agent", nargs="?", default=AGENTS.DEFAULT, help=f"{' | '.join(AGENTS.AGENTS)} | any agent CLI")
    parser.add_argument("--project", default=".")
    parser.add_argument("--no-watch", action="store_true", help="Do not start the local inbox watcher")
    parser.add_argument("--ask", action="store_true", help="Use the agent's normal approval prompts instead of "
                        "Claude auto mode / Codex 'Approve for me'")
    argv = sys.argv[1:]
    cut = argv.index("--") if "--" in argv else len(argv)
    args = parser.parse_args(argv[:cut])
    extra = argv[cut + 1:]  # everything after -- goes to the agent unchanged
    agent = AGENTS.spec(args.agent)
    project = Path(args.project).expanduser().resolve()
    listing = subprocess.run(["git", "worktree", "list", "--porcelain"], cwd=project, text=True, capture_output=True)
    if listing.returncode:
        raise SystemExit(f"{project} is not a git repository; run `git init`, make a first commit, then `ar_init`.")
    root = Path(listing.stdout.splitlines()[0].split(" ", 1)[1])
    if root != project:
        print(f"Using the main checkout {root} (the mate never runs inside an idea worktree).")
    if not (root / ".agents/skills/ar_mate").exists():
        raise SystemExit(f"{root} is not set up; run: ar_init {root}")
    os.chdir(root)
    loader = importlib.machinery.SourceFileLoader("ar_init", str(NEO / "ar_init"))
    init_spec = importlib.util.spec_from_loader("ar_init", loader)
    init = importlib.util.module_from_spec(init_spec)
    loader.exec_module(init)
    log = init.link_assets(root, log=init.link_agents(root))
    init.git_exclude(root, False, log)  # e.g. __board__/mate/ after an update
    refreshed = [line for line in log if not line.startswith(("ok", "keep"))]
    if refreshed:  # new or removed shared skills after a `git pull` of neo_research
        print("Refreshed links:\n  " + "\n  ".join(refreshed))
    if subprocess.run(["git", "rev-parse", "--verify", "-q", "HEAD"], capture_output=True).returncode:
        print("Note: no commits yet; ideas (ar_tree new) need a first commit of the project's code.")
    if not args.no_watch:
        subprocess.run([sys.executable, str(WATCH), "--ensure"], cwd=root)
    subprocess.run([sys.executable, str(STATUS)], cwd=root)  # instant, no tokens
    subprocess.run([sys.executable, str(STATUS), "--inbox", "--peek"], cwd=root)
    permissions = [] if args.ask else agent["mate"]
    preamble = ""
    if agent.get("guard"):  # hard stop on code edits by the mate: Claude hook / Codex sandbox writable only in __board__/
        permissions = [*permissions, *agent["guard"](GUARD[args.agent], root)]
        preamble = (f"Project root: {root}. Your shell starts in {root}/__board__, the only folder you can write; "
                    f"run project commands as `cd {root} && ...`. The status table was already shown to the human; "
                    f"wait for their message.\n\n")
    if agent["rules"]:
        command = [*agent["interactive"], *permissions, *agent["rules"](SKILL, preamble), *extra]
    else:
        print(f"{args.agent}: no standing-instructions option known; the mate rules are only in the first prompt.")
        command = [*agent["interactive"], *permissions, *extra, f"Read {SKILL} and act as the project's first mate."]
    keys = PROJECT_ENV.load_keys(PROJECT_ENV.env_file(root))
    if keys.get("CONDA_ENV") and keys["CONDA_ENV"] == os.environ.get("CONDA_DEFAULT_ENV"):
        keys.pop("CONDA_ENV")  # already active
    activate = PROJECT_ENV.activation(keys)
    if activate:  # the mate (and every command it runs) works inside the project's code environment
        print(f"Environment: {keys.get('CONDA_ENV') or keys.get('ENV_ACTIVATE')}")
        command = ["bash", "-c", f'{activate} && exec "$@"', "ar_mate", *command]
    os.execvp(command[0], command)


if __name__ == "__main__":
    main()
