#!/usr/bin/env python3
"""Start the first mate for a project: Slack watcher in the background, then Claude with the
ar_mate rules in its system prompt, so it stays the mate through long sessions and compaction.

    cd my-project && /path/to/neo_research/ar_mate          # or: ar_mate <project>
    ar_mate <project> -- --model opus                        # extra flags after -- go to claude

Run it in Herdr tab 0. Typing /ar_mate inside a normal session also works, but only this
launcher keeps the rules in the system prompt.
"""

import argparse
import os
from pathlib import Path
import subprocess
import sys

NEO = Path(__file__).resolve().parent
SKILL = NEO / "skills/ar_mate/SKILL.md"
WATCH = NEO / "skills/ar_mate/scripts/mate_watch.py"


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("project", nargs="?", default=".")
    parser.add_argument("--no-watch", action="store_true", help="Do not start the Slack watcher")
    parser.add_argument("claude_args", nargs=argparse.REMAINDER, help="-- <extra claude flags>")
    args = parser.parse_args()
    project = Path(args.project).expanduser().resolve()
    listing = subprocess.run(["git", "worktree", "list", "--porcelain"], cwd=project, text=True, capture_output=True)
    if listing.returncode:
        raise SystemExit(f"{project} is not a git repository; run ./ar_init on it first.")
    root = Path(listing.stdout.splitlines()[0].split(" ", 1)[1])
    if root != project:
        print(f"Using the main checkout {root} (the mate never runs inside an idea worktree).")
    if not (root / ".agents/skills/ar_mate").exists():
        raise SystemExit(f"{root} is not set up; run: {NEO}/ar_init {root}")
    os.chdir(root)
    if not args.no_watch:
        subprocess.run([sys.executable, str(WATCH), "--ensure"], cwd=root)
    extra = args.claude_args[1:] if args.claude_args[:1] == ["--"] else args.claude_args
    command = ["claude", "--append-system-prompt-file", str(SKILL), *extra, "/ar_mate status"]
    os.execvp(command[0], command)


if __name__ == "__main__":
    main()
