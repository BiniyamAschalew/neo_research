# Copy to secrets/slack.env (gitignored) on each machine and fill in.
# Text-only: an Incoming Webhook URL is enough.
SLACK_WEBHOOK_URL=
# Figures: Slack webhooks cannot upload files. For images, create a Slack app
# with bot scopes chat:write and files:write, invite it to the channel, and set:
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
